  "strings" : {
    "autoLaunchFailed" : {
      "comment" : "Alert title; the system error follows as detail.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed to configure launch at login. Please check system permissions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法配置开机自启功能,请检查系统权限设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法配置開機自啟功能,請檢查系統權限設定。"
          }
        }
      }
    },
    "autoType" : {
      "comment" : "Toggle menu item: type the password instead of copying it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-Type"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动键入"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動鍵入"
          }
        }
      }
    },
    "autoTypePermissionDetail" : {
      "comment" : "Alert detail; names the System Settings path.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow FlowerPassword in System Settings → Privacy & Security → Accessibility, then enable Auto-Type again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在「系统设置 → 隐私与安全性 → 辅助功能」中允许 FlowerPassword,然后重新开启自动键入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「系統設定 → 隱私權與安全性 → 輔助使用」中允許 FlowerPassword,然後重新開啟自動鍵入。"
          }
        }
      }
    },
