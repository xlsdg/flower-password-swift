          }
        }
      }
    },
    "updateErrorUnsafeVolume" : {
      "comment" : "Update failure reason; the argument is a folder path.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The volume holding %@ ignores file ownership, so in-place updates are unsafe there."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 所在的宗卷忽略文件归属权,在此处原地更新并不安全。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 所在的儲存空間忽略檔案擁有權,在此處原地更新並不安全。"
          }
        }
      }
